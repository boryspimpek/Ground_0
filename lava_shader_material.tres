[sub_resource type="Shader" id="Shader_ekblm"]
code = "// Shader zmodyfikowany: wyczyszczony ze zbędnych parametrów Godota + Triplanar + Lava Pulse
shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;
// --- TEKSTURY I PODSTAWOWE WŁAŚCIWOŚCI ---
uniform vec4 albedo : source_color = vec4(1.0);
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float roughness : hint_range(0.0, 1.0) = 1.0;
uniform sampler2D texture_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;
uniform float metallic : hint_range(0.0, 1.0, 0.01) = 0.0;
uniform sampler2D texture_metallic : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform float specular : hint_range(0.0, 1.0, 0.01) = 0.5;
// --- NORMAL MAPA ---
uniform sampler2D texture_normal : hint_roughness_normal, filter_linear_mipmap, repeat_enable;
uniform float normal_scale : hint_range(-16.0, 16.0, 0.01) = 1.0;
// --- SKALOWANIE TRIPLANARNE (UV1) ---
uniform float uv1_blend_sharpness : hint_range(0.0, 150.0, 0.001) = 1.0;
uniform vec3 uv1_scale = vec3(1.0);
uniform vec3 uv1_offset = vec3(0.0);
varying vec3 uv1_triplanar_pos;
varying vec3 uv1_power_normal;
// --- PARAMETRY PULSOWANIA LAWY ---
uniform float pulse_speed : hint_range(0.0, 10.0, 0.1) = 3.0;
uniform float emission_energy : hint_range(0.0, 20.0, 0.1) = 3.0;
uniform float pulse_strength : hint_range(0.0, 5.0, 0.1) = 1.0;
uniform float lava_threshold : hint_range(0.0, 1.0, 0.01) = 0.2;
// --- KOLORY LAWY ---
uniform vec4 color_lava_cool : source_color = vec4(0.6, 0.1, 0.0, 1.0);
uniform vec4 color_lava_hot : source_color = vec4(1.0, 0.8, 0.3, 1.0);
uniform float orange_hold : hint_range(0.1, 10.0, 0.1) = 3.0;
instance uniform float phase_offset : hint_range(0.0, 6.2832, 0.01) = 0.0;
void vertex() {
	vec3 normal = NORMAL;
	TANGENT = vec3(0.0, 0.0, -1.0) * abs(normal.x);
	TANGENT += vec3(1.0, 0.0, 0.0) * abs(normal.y);
	TANGENT += vec3(1.0, 0.0, 0.0) * abs(normal.z);
	TANGENT = normalize(TANGENT);
	BINORMAL = vec3(0.0, 1.0, 0.0) * abs(normal.x);
	BINORMAL += vec3(0.0, 0.0, -1.0) * abs(normal.y);
	BINORMAL += vec3(0.0, 1.0, 0.0) * abs(normal.z);
	BINORMAL = normalize(BINORMAL);
	// Przygotowanie triplanarnych pozycji
	uv1_power_normal = pow(abs(NORMAL), vec3(uv1_blend_sharpness));
	uv1_triplanar_pos = VERTEX * uv1_scale + uv1_offset;
	uv1_power_normal /= dot(uv1_power_normal, vec3(1.0));
	uv1_triplanar_pos *= vec3(1.0, -1.0, 1.0);
}
vec4 triplanar_texture(sampler2D p_sampler, vec3 p_weights, vec3 p_triplanar_pos) {
	vec4 samp = vec4(0.0);
	samp += texture(p_sampler, p_triplanar_pos.xy) * p_weights.z;
	samp += texture(p_sampler, p_triplanar_pos.xz) * p_weights.y;
	samp += texture(p_sampler, p_triplanar_pos.zy * vec2(-1.0, 1.0)) * p_weights.x;
	return samp;
}
void fragment() {
	// Pobieranie teksturowania Triplanar
	vec4 albedo_tex = triplanar_texture(texture_albedo, uv1_power_normal, uv1_triplanar_pos);
	ALBEDO = albedo.rgb * albedo_tex.rgb;
	// Pobieranie kanału R dla szorstkości i metaliczności
	float metallic_tex = triplanar_texture(texture_metallic, uv1_power_normal, uv1_triplanar_pos).r;
	METALLIC = metallic_tex * metallic;
	SPECULAR = specular;
	float roughness_tex = triplanar_texture(texture_roughness, uv1_power_normal, uv1_triplanar_pos).r;
	ROUGHNESS = roughness_tex * roughness;
	// Normal mapa
	vec4 normal_tex = triplanar_texture(texture_normal, uv1_power_normal, uv1_triplanar_pos);
	NORMAL_MAP = normal_tex.rgb;
	NORMAL_MAP_DEPTH = normal_scale;
	// Świecenie lawy
	float brightness = dot(albedo_tex.rgb, vec3(0.299, 0.587, 0.114));
	float lava_mask = smoothstep(lava_threshold, lava_threshold + 0.2, brightness);
	float pulse = (sin(TIME * pulse_speed + phase_offset) + 1.0) * 0.5;
	
	float pulse_curve = pow(pulse, orange_hold);
	vec3 dynamic_lava_color = mix(color_lava_cool.rgb, color_lava_hot.rgb, pulse_curve * min(1.0, pulse_strength));
	
	EMISSION = dynamic_lava_color * lava_mask * emission_energy;
}"

[resource]
render_priority = 0
shader = SubResource("Shader_ekblm")
shader_parameter/albedo = Color(1, 1, 1, 1)
shader_parameter/texture_albedo = ExtResource("1_ekblm")
shader_parameter/roughness = 1.0
shader_parameter/metallic = 0.0
shader_parameter/specular = 0.5
shader_parameter/texture_normal = ExtResource("2_ln08j")
shader_parameter/normal_scale = 3.4799995645830393
shader_parameter/uv1_blend_sharpness = 1.0
shader_parameter/uv1_scale = Vector3(0.085, 0.085, 0.085)
shader_parameter/uv1_offset = Vector3(0, 0, 0)
shader_parameter/pulse_speed = 1.0000000149012
shader_parameter/emission_energy = 1.20000001788144
shader_parameter/pulse_strength = 3.0000000447036
shader_parameter/lava_threshold = 0.1999999955296
shader_parameter/color_lava_cool = Color(1, 0, 0, 1)
shader_parameter/color_lava_hot = Color(1, 1, 0, 1)
shader_parameter/orange_hold = 4.0000000596048
